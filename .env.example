# Optional: NYC Open Data Socrata app token for higher rate limits
# Get one free at https://data.cityofnewyork.us
VITE_SODA_APP_TOKEN=

# Required: CARTO basemap key (free, no account) from https://carto.com/basemaps/apikey
# Without it the map background shows an "API KEY REQUIRED" watermark
VITE_CARTO_KEY=
